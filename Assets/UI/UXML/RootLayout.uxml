<UXML xmlns="UnityEngine.UIElements">
    <Style src="/Assets/UI/USS/variables.uss" />
    <Style src="/Assets/UI/USS/common.uss" />
    <Style src="/Assets/UI/USS/RootLayout.uss" />
    <Template name="FieldOverlay" src="/Assets/UI/UXML/FieldOverlay.uxml" />
    <Template name="BottomPanel" src="/Assets/UI/UXML/BottomPanel.uxml" />
    <Template name="SlimeCodexModal" src="/Assets/UI/UXML/SlimeCodexModal.uxml" />
    <Template name="MonsterCodexModal" src="/Assets/UI/UXML/MonsterCodexModal.uxml" />
    <Template name="MerchantModal" src="/Assets/UI/UXML/MerchantModal.uxml" />
    <VisualElement name="root" class="root" picking-mode="Ignore">
        <VisualElement name="zone-field" class="zone-field" picking-mode="Ignore">
            <Instance template="FieldOverlay" name="field-overlay" picking-mode="Ignore" />
        </VisualElement>
        <Instance template="BottomPanel" name="zone-bottom" />
        <VisualElement name="summon-modal-overlay" class="summon-modal-overlay hidden">
            <VisualElement name="summon-modal-backdrop" class="summon-modal__backdrop" picking-mode="Ignore" />
            <VisualElement name="summon-modal-panel" class="summon-modal__panel">
                <Label name="summon-modal-title" class="summon-modal__title" text="용병 소환" picking-mode="Ignore" />
                <Label name="summon-modal-subtitle" class="summon-modal__subtitle" text="계약서 1장을 사용했습니다" picking-mode="Ignore" />
                <VisualElement name="summon-modal-reel-viewport" class="summon-modal-reel-viewport" picking-mode="Ignore">
                    <VisualElement name="summon-modal-reel-strip" class="summon-modal-reel-strip" picking-mode="Ignore" />
                    <VisualElement name="summon-modal-center-marker" class="summon-modal-center-marker" picking-mode="Ignore" />
                </VisualElement>
                <Label name="summon-modal-result-label" class="summon-modal__result" text="소환 준비" picking-mode="Ignore" />
                <Button name="summon-modal-skip-button" class="summon-modal__skip btn btn--primary" text="결과 보기" />
            </VisualElement>
        </VisualElement>
        <VisualElement name="unit-detail-overlay" class="unit-detail-overlay hidden">
            <VisualElement name="unit-detail-backdrop" class="unit-detail__backdrop" />
            <VisualElement name="unit-detail-panel" class="unit-detail__panel">
                <Button name="unit-detail-close-button" class="unit-detail__close btn" text="닫기" />
                <Image name="unit-detail-icon" class="unit-detail__icon" picking-mode="Ignore" />
                <Label name="unit-detail-name" class="unit-detail__name" text="유닛 이름" picking-mode="Ignore" />
                <Label name="unit-detail-rank" class="unit-detail__rank" text="기본" picking-mode="Ignore" />
                <VisualElement class="unit-detail__tags" picking-mode="Ignore">
                    <Label name="unit-detail-rarity" class="unit-detail__tag" text="일반" picking-mode="Ignore" />
                    <Label name="unit-detail-attribute" class="unit-detail__tag" text="무속성" picking-mode="Ignore" />
                    <Label name="unit-detail-attack-style" class="unit-detail__tag" text="근접" picking-mode="Ignore" />
                </VisualElement>
                <VisualElement class="unit-detail__stats" picking-mode="Ignore">
                    <VisualElement class="unit-detail__stat-row">
                        <Label class="unit-detail__stat-name" text="공격력" />
                        <Label name="unit-detail-damage" class="unit-detail__stat-value" text="0" />
                    </VisualElement>
                    <VisualElement class="unit-detail__stat-row">
                        <Label class="unit-detail__stat-name" text="초당 공격" />
                        <Label name="unit-detail-attack-speed" class="unit-detail__stat-value" text="0" />
                    </VisualElement>
                    <VisualElement class="unit-detail__stat-row">
                        <Label class="unit-detail__stat-name" text="공격 범위" />
                        <Label name="unit-detail-attack-range" class="unit-detail__stat-value" text="0" />
                    </VisualElement>
                    <VisualElement class="unit-detail__stat-row">
                        <Label class="unit-detail__stat-name" text="이동 속도" />
                        <Label name="unit-detail-move-speed" class="unit-detail__stat-value" text="0" />
                    </VisualElement>
                    <VisualElement class="unit-detail__stat-row">
                        <Label class="unit-detail__stat-name" text="★3 스킬" />
                        <Label name="unit-detail-star3-skill" class="unit-detail__stat-value" text="해금 예정" />
                    </VisualElement>
                </VisualElement>
                <VisualElement name="unit-detail-upgrade" class="unit-detail__upgrade">
                    <VisualElement class="unit-detail__upgrade-info" picking-mode="Ignore">
                        <Label name="unit-detail-upgrade-level" class="unit-detail__upgrade-level" text="슬라임 Lv.1" />
                        <Label name="unit-detail-upgrade-values" class="unit-detail__upgrade-values" text="공격 100% → 108% · 공속 100% → 103%" />
                    </VisualElement>
                    <Button name="unit-detail-upgrade-button" class="btn btn--primary unit-detail__upgrade-button" text="25 G" />
                </VisualElement>
                <Label class="unit-detail__hint" text="슬롯을 길게 끌어 필드에 배치할 수 있습니다." picking-mode="Ignore" />
            </VisualElement>
        </VisualElement>
        <Instance template="SlimeCodexModal" name="slime-codex-modal" class="modal-host" picking-mode="Ignore" />
        <Instance template="MonsterCodexModal" name="monster-codex-modal" class="modal-host" picking-mode="Ignore" />
        <Instance template="MerchantModal" name="merchant-modal" class="modal-host" picking-mode="Ignore" />
    </VisualElement>
</UXML>
