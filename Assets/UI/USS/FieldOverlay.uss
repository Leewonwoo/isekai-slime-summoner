.field-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Stage stays in the upper-left while wave status remains centered above combat. */
.field-overlay__stage-wave {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-transparent);
}

.field-overlay__stage {
    position: absolute;
    left: var(--gap-lg);
    top: var(--gap-lg);
    width: var(--stage-overlay-width);
    align-items: flex-start;
    justify-content: center;
    background-color: var(--color-transparent);
}

.field-overlay__stage-caption {
    width: 100%;
    color: var(--color-text-dim);
    font-size: var(--font-small);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.field-overlay__stage-name {
    width: 100%;
    color: var(--color-text);
    font-size: var(--font-body);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.field-overlay__wave-status {
    position: absolute;
    left: 50%;
    top: var(--gap-md);
    translate: -50% 0;
    width: var(--wave-status-width);
    align-items: center;
    justify-content: center;
    background-color: var(--color-transparent);
}

.field-overlay__wave {
    color: var(--color-gold);
    font-size: var(--font-title);
    -unity-font-style: bold;
}

.field-overlay__remaining {
    color: var(--color-text-dim);
    font-size: var(--font-caption);
    margin-top: var(--gap-xs);
}

.field-overlay__combo {
    height: var(--combo-label-height);
    color: var(--color-text);
    font-size: var(--font-body);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: color, font-size;
    transition-duration: 0.12s;
}

.combo--milestone {
    color: var(--color-overdrive);
    font-size: var(--font-title);
}

.overdrive-cluster {
    position: absolute;
    right: var(--overdrive-gauge-right);
    bottom: var(--overdrive-gauge-bottom);
    width: var(--overdrive-status-width);
    align-items: flex-end;
}

.overdrive-gauge {
    width: var(--overdrive-gauge-width);
    height: var(--overdrive-gauge-height);
    overflow: hidden;
    background-color: var(--color-panel-deep);
    border-left-width: var(--gap-xs);
    border-right-width: var(--gap-xs);
    border-top-width: var(--gap-xs);
    border-bottom-width: var(--gap-xs);
    border-left-color: var(--color-overdrive-deep);
    border-right-color: var(--color-overdrive-deep);
    border-top-color: var(--color-overdrive-deep);
    border-bottom-color: var(--color-overdrive-deep);
    border-radius: var(--radius-md);
}

.overdrive-gauge__fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: var(--color-overdrive);
    border-radius: var(--radius-sm);
}

.overdrive-gauge__label {
    width: var(--overdrive-status-width);
    height: var(--overdrive-status-height);
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: var(--gap-sm);
    color: var(--color-text);
    font-size: var(--font-small);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.overdrive-gauge__tick {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--overdrive-gauge-tick-height);
    background-color: var(--color-overdrive-deep);
}

.overdrive-gauge__tick--quarter {
    bottom: 25%;
}

.overdrive-gauge__tick--half {
    bottom: 50%;
}

.overdrive-gauge__tick--three-quarter {
    bottom: 75%;
}

.overdrive--charging .overdrive-gauge__label {
    color: var(--color-transparent);
}

.overdrive--ready .overdrive-gauge {
    border-left-color: var(--color-overdrive);
    border-right-color: var(--color-overdrive);
    border-top-color: var(--color-overdrive);
    border-bottom-color: var(--color-overdrive);
}

.overdrive--active .overdrive-gauge__label {
    color: var(--color-text);
}

.field-menu-stack {
    position: absolute;
    right: var(--gap-lg);
    top: var(--gap-lg);
    width: var(--field-menu-width);
    flex-direction: column;
    align-items: flex-end;
}

.field-menu-top-row {
    width: 100%;
    height: var(--field-settings-size);
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: var(--gap-sm);
}

.field-settings-button {
    width: var(--field-settings-size);
    height: var(--field-settings-size);
    margin-left: var(--gap-sm);
    background-color: var(--color-transparent);
    background-image: url("project://database/Assets/Art/UIIcons/icon_settings.png?fileID=21300000&guid=39c989c3992a75b48b8c672fc77e1e56&type=3");
    background-size: var(--field-settings-icon-size) var(--field-settings-icon-size);
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.field-settings-button:active {
    translate: 0 2px;
    background-color: var(--color-transparent);
}

.speed-toggle-button {
    width: var(--field-speed-width);
    height: var(--field-settings-size);
    color: var(--color-text);
    background-color: var(--color-panel-deep);
    border-width: var(--gap-xs);
    border-color: var(--color-gold-deep);
    border-radius: var(--radius-md);
    font-size: var(--font-caption);
    -unity-font-style: bold;
}

.speed-toggle-button--fast {
    color: var(--color-ink);
    background-color: var(--color-gold);
    border-color: var(--color-gold);
}

.speed-toggle-button:active {
    translate: 0 2px;
}

.codex-button {
    width: var(--codex-button-size);
    height: var(--codex-button-size);
    background-color: var(--color-transparent);
    background-size: var(--codex-button-icon-size) var(--codex-button-icon-size);
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    border-width: 0;
    border-radius: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.slime-codex-button {
    margin-bottom: var(--gap-sm);
    background-image: url("project://database/Assets/Art/UIIcons/icon_codex_slime.png?fileID=21300000&guid=86a9f153891edeb41917e45e99f56499&type=3");
}

.monster-codex-button {
    background-image: url("project://database/Assets/Art/UIIcons/icon_codex_monster.png?fileID=21300000&guid=300a16d5c9dba7f41b8218131afe5a34&type=3");
}

.codex-button:active {
    translate: 0 2px;
    background-color: var(--color-transparent);
    opacity: 0.82;
}

.unlock-toast {
    position: absolute;
    left: var(--unlock-toast-inset-x);
    right: var(--unlock-toast-inset-x);
    top: var(--unlock-toast-top);
    min-height: var(--touch-min);
    color: var(--color-ink);
    background-color: var(--color-gold);
    border-width: var(--gap-xs);
    border-color: var(--color-gold-deep);
    border-radius: var(--radius-lg);
    font-size: var(--font-body);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.golden-goblin-banner {
    position: absolute;
    left: 50%;
    top: 176px;
    translate: -50% 0;
    width: 84%;
    max-width: 760px;
    min-height: 104px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(255, 205, 58);
    border-width: var(--gap-xs);
    border-color: rgb(130, 78, 12);
    border-radius: var(--radius-lg);
    padding-left: var(--gap-lg);
    padding-right: var(--gap-lg);
    padding-top: var(--gap-sm);
    padding-bottom: var(--gap-sm);
    opacity: 0.96;
    overflow: hidden;
}

.golden-goblin-banner__title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: rgb(54, 31, 5);
    font-size: var(--font-body);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
}

.golden-goblin-banner__timer {
    flex-shrink: 0;
    width: 132px;
    min-height: 64px;
    margin-left: var(--gap-md);
    color: rgb(255, 239, 178);
    background-color: rgb(129, 75, 12);
    border-radius: var(--radius-md);
    padding-left: var(--gap-sm);
    padding-right: var(--gap-sm);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.golden-goblin-banner--warning {
    background-color: rgb(255, 226, 112);
}

.golden-goblin-banner--warning .golden-goblin-banner__timer {
    color: rgb(255, 242, 188);
    background-color: rgb(112, 68, 16);
}

.golden-goblin-banner--defeated {
    background-color: rgb(116, 220, 117);
    border-color: rgb(36, 100, 43);
}

.golden-goblin-banner--defeated .golden-goblin-banner__timer {
    width: 160px;
    color: rgb(224, 255, 220);
    background-color: rgb(36, 100, 43);
    font-size: 32px;
}

.golden-goblin-banner--escaped {
    background-color: rgb(110, 105, 96);
    border-color: rgb(52, 49, 45);
}

.golden-goblin-banner--escaped .golden-goblin-banner__title,
.golden-goblin-banner--escaped .golden-goblin-banner__timer {
    color: rgb(244, 238, 224);
}

.golden-goblin-banner--message-only .golden-goblin-banner__title {
    width: 100%;
    -unity-text-align: middle-center;
}

.golden-goblin-banner--message-only .golden-goblin-banner__timer {
    display: none;
}

.field-overlay__wave--rush {
    color: var(--color-danger);
}

/* 스킬 플로팅 버튼 (우하단) — 공용 돌 링 */
.skill-button {
    position: absolute;
    right: var(--gap-lg);
    bottom: var(--gap-lg);
    width: var(--skill-button-size);
    height: var(--skill-button-size);
    border-radius: var(--skill-button-radius);
    background-color: var(--color-panel-deep);
    background-image: url("project://database/Assets/Art/UIFrames/frame_ring.png?fileID=21300000&guid=9603ecb7000a32e47a1b0382e5871157&type=3");
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    border-width: 0;
    color: var(--color-gold);
    font-size: var(--font-caption);
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.skill-button:active {
    background-color: var(--color-surface-deep);
}

.skill-button__name {
    color: var(--color-gold);
    font-size: var(--skill-button-label-size);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.skill-button__icon {
    width: var(--skill-button-icon-size);
    height: var(--skill-button-icon-size);
    flex-shrink: 0;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
}

.skill-icon--meteor {
    background-image: url("project://database/Assets/Art/UIIcons/icon_skill_meteor.png");
}

.skill-icon--ice-wall {
    background-image: url("project://database/Assets/Art/UIIcons/icon_skill_ice_wall.png");
}

.skill-icon--aegis {
    background-image: url("project://database/Assets/Art/UIIcons/icon_skill_aegis.png");
}

.skill-button__cooldown {
    color: var(--color-text);
    font-size: var(--skill-button-cooldown-size);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.skill-button--cooldown {
    opacity: 0.72;
}

.skill-button--targeting {
    background-color: var(--color-surface-deep);
}

.buff-skill-cluster {
    position: absolute;
    right: var(--buff-skill-cluster-right);
    bottom: var(--buff-skill-cluster-bottom);
    flex-direction: row;
}

.buff-skill-button {
    width: var(--buff-skill-button-size);
    height: var(--buff-skill-button-size);
    margin-left: var(--gap-sm);
    border-radius: var(--buff-skill-button-radius);
    background-color: var(--color-panel-deep);
    background-image: url("project://database/Assets/Art/UIFrames/frame_ring.png?fileID=21300000&guid=9603ecb7000a32e47a1b0382e5871157&type=3");
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-items: center;
    justify-content: center;
}

.buff-skill-button:active {
    background-color: var(--color-surface-deep);
}

.buff-skill-button__icon {
    width: var(--buff-skill-icon-size);
    height: var(--buff-skill-icon-size);
    flex-shrink: 0;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
}

.buff-skill-button__name {
    color: var(--color-gold);
    font-size: var(--font-small);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.buff-skill-button__cooldown {
    position: absolute;
    color: var(--color-text);
    font-size: var(--skill-button-cooldown-size);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.buff-skill-button--cooldown {
    opacity: 0.72;
}

.buff-skill-button--active {
    background-color: var(--color-positive);
}

.buff-skill-button--empty {
    opacity: 0.45;
}

.buff-icon--aegis {
    background-image: url("project://database/Assets/Art/UIIcons/icon_skill_aegis.png");
}

.buff-icon--life {
    background-image: url("project://database/Assets/Art/UIIcons/icon_hp.png");
}

.buff-icon--command {
    background-image: url("project://database/Assets/Art/UIIcons/icon_aspd.png");
}

.buff-icon--resonance {
    background-image: url("project://database/Assets/Art/UIIcons/icon_tab_gear.png");
}

.buff-icon--time {
    background-image: url("project://database/Assets/Art/UIIcons/icon_crit.png");
}
