.bottom-panel {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--color-panel);
    border-top-width: 3px;
    border-top-color: var(--color-bg);
}

/* ── 탭바 — 활성 탭 = "눌려서 켜진 나무 버튼" (스킨 문법 ④) ── */
.tab-bar {
    flex-direction: row;
    height: var(--tab-height);
    flex-shrink: 0;
    background-color: var(--color-bg);
}

.tab-bar__button {
    width: var(--tab-button-width);
    flex-grow: 0;
    flex-shrink: 0;
    background-color: var(--color-transparent);
    background-image: url("project://database/Assets/Art/UIFrames/tab_button_inactive_frame.png?fileID=21300000&guid=4b370e3f80ff324488564d5f144fc62c&type=3");
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    -unity-slice-left: var(--tab-frame-slice-x);
    -unity-slice-top: var(--tab-frame-slice-y);
    -unity-slice-right: var(--tab-frame-slice-x);
    -unity-slice-bottom: var(--tab-frame-slice-y);
    -unity-slice-scale: var(--tab-frame-slice-scale);
    border-width: 0;
    border-radius: 0;
    margin: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.tab-bar__content {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.tab-bar__icon {
    width: var(--tab-icon-size);
    height: var(--tab-icon-size);
    flex-shrink: 0;
    margin-right: var(--gap-sm);
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
}

.tab-bar__label {
    color: var(--color-text-dim);
    font-size: var(--font-body);
    -unity-font-style: bold;
}

.tab-bar__icon--summon {
    background-image: url("project://database/Assets/Art/UIIcons/icon_tab_summon.png?fileID=21300000&guid=3d5255647ec6801469b4487b9bb0ceac&type=3");
}

.tab-bar__icon--upgrade {
    background-image: url("project://database/Assets/Art/UIIcons/icon_tab_upgrade.png?fileID=21300000&guid=af41d51bba26c1c488ffaf2311d65cbf&type=3");
}

.tab-bar__icon--skill {
    background-image: url("project://database/Assets/Art/UIIcons/icon_tab_skill.png?fileID=21300000&guid=1b80b2545c8ee2d4fb3b378accacab38&type=3");
}

.tab-bar__icon--gear {
    background-image: url("project://database/Assets/Art/UIIcons/icon_tab_gear.png?fileID=21300000&guid=33980143fa2f41744b61f8386ed88041&type=3");
}

.tab-bar__icon--summoner {
    background-image: url("project://database/Assets/Art/UIIcons/icon_tab_summoner.png?fileID=21300000&guid=ae54b462d6d31e64b8a00ccda1e5876c&type=3");
}

.tab-bar__button:active {
    background-image: url("project://database/Assets/Art/UIFrames/tab_button_active_frame.png?fileID=21300000&guid=fc9e0a70fc4b587479189c9e988950d6&type=3");
}

.tab-bar__button--active {
    background-image: url("project://database/Assets/Art/UIFrames/tab_button_active_frame.png?fileID=21300000&guid=fc9e0a70fc4b587479189c9e988950d6&type=3");
}

.tab-bar__button--active .tab-bar__label {
    color: var(--color-ink);
}

/* ── 탭 콘텐츠 ─────────────────────── */
.tab-content {
    flex-grow: 1;
    background-color: var(--color-panel-deep);
    background-image: url("project://database/Assets/Art/UIFrames/bottom_panel_content_frame.png?fileID=21300000&guid=16a4f8ca4603d254b888b78dbf58666b&type=3");
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    -unity-slice-left: 92px;
    -unity-slice-top: 92px;
    -unity-slice-right: 92px;
    -unity-slice-bottom: 92px;
    -unity-slice-scale: 0.4;
    padding-top: var(--bottom-panel-content-inset);
    padding-bottom: var(--bottom-panel-content-inset);
    padding-left: var(--bottom-panel-content-inset);
    padding-right: var(--bottom-panel-content-inset);
}

.tab-page {
    flex-grow: 1;
}

.row-list {
    flex-grow: 1;
}

/* ── 소환 탭 ───────────────────────── */
.summon-tab {
    flex-grow: 1;
    flex-direction: row;
    padding-top: var(--gap-md);
    padding-bottom: var(--gap-md);
    padding-left: var(--gap-md);
    padding-right: var(--gap-md);
}

.summon-tab__inventory {
    flex-grow: 1;
}

.summon-tab__inventory-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: var(--touch-min);
    padding-left: var(--gap-sm);
    padding-right: var(--gap-md);
}

.summon-tab__inventory-title {
    color: var(--color-text);
    font-size: var(--font-body);
    -unity-font-style: bold;
}

.summon-tab__inventory-count {
    color: var(--color-text-dim);
    font-size: var(--font-caption);
}

.bench {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

/* 벤치 슬롯 = 돌에 파인 홈 (recess) — 판재(버튼)와 반대로 어둡게 */
.bench-slot {
    width: var(--bench-slot-size);
    height: var(--bench-slot-size);
    margin-top: var(--gap-sm);
    margin-bottom: var(--gap-sm);
    margin-left: var(--gap-sm);
    margin-right: var(--gap-sm);
    background-color: var(--color-panel-deep);
    background-image: url("project://database/Assets/Art/UIFrames/bench_slot_frame.png?fileID=21300000&guid=162f6efbc056f5748b5a9b30af5c90de&type=3");
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    -unity-slice-left: 190px;
    -unity-slice-top: 190px;
    -unity-slice-right: 190px;
    -unity-slice-bottom: 190px;
    -unity-slice-scale: 0.1;
    border-radius: var(--radius-md);
    border-width: var(--bench-slot-state-border);
    border-color: var(--color-transparent);
}

.bench-slot--mergeable {
    border-color: var(--color-positive);
}

.bench-card {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.bench-card__rank {
    color: var(--color-gold);
    font-size: var(--font-caption);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.bench-card__name {
    color: var(--color-text);
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.summon-tab__right {
    position: relative;
    width: var(--summon-side-width);
    justify-content: flex-end;
    margin-left: var(--gap-md);
}

.summon-tab__contracts {
    min-height: var(--summon-contract-panel-height);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: var(--radius-sm);
    padding-left: var(--gap-md);
    padding-right: var(--gap-md);
    margin-bottom: var(--gap-sm);
}

.summon-tab__contracts-title {
    color: var(--color-ink);
    font-size: var(--font-caption);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.summon-tab__contracts-value {
    color: var(--color-ink);
    font-size: var(--font-body);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.summon-tab__pool {
    color: var(--color-text-disabled);
    font-size: var(--font-caption);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: var(--gap-sm);
}

.summon-tab__prob {
    color: var(--color-text-dim);
    font-size: var(--font-caption);
    -unity-text-align: middle-center;
    background-color: var(--color-panel-deep);
    border-width: 2px;
    border-color: var(--color-bg);
    border-radius: var(--radius-sm);
    padding-top: var(--gap-sm);
    padding-bottom: var(--gap-sm);
    margin-bottom: var(--gap-sm);
    white-space: normal;
}

.summon-tab__button {
    min-height: var(--row-height);
}

/* ── 장비 탭 ───────────────────────── */
.gear-tab {
    flex-grow: 1;
    padding-top: var(--gap-md);
    padding-left: var(--gap-md);
    padding-right: var(--gap-md);
}

.gear-tab__hint {
    color: var(--color-text-disabled);
    font-size: var(--font-caption);
    margin-bottom: var(--gap-sm);
}

/* ── 소환사 탭 ─────────────────────── */
.summoner-tab {
    flex-grow: 1;
}

.summoner-tab__profile {
    height: var(--summoner-tab-profile-height);
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    background-color: var(--color-bg);
    border-width: 2px;
    border-color: var(--color-panel);
    border-radius: var(--radius-md);
    margin-top: var(--gap-sm);
    margin-left: var(--gap-md);
    margin-right: var(--gap-md);
    padding-left: var(--gap-md);
    padding-right: var(--gap-md);
}

.summoner-tab__portrait-frame {
    width: var(--summoner-portrait-size);
    height: var(--summoner-portrait-size);
    flex-shrink: 0;
    border-radius: var(--summoner-portrait-radius);
    background-color: var(--color-transparent);
    background-image: url("project://database/Assets/Art/UIFrames/frame_ring.png?fileID=21300000&guid=9603ecb7000a32e47a1b0382e5871157&type=3");
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    padding-top: var(--portrait-ring-inset);
    padding-bottom: var(--portrait-ring-inset);
    padding-left: var(--portrait-ring-inset);
    padding-right: var(--portrait-ring-inset);
    margin-right: var(--gap-md);
}

.summoner-tab__portrait {
    flex-grow: 1;
    border-radius: var(--summoner-portrait-radius);
    background-color: var(--color-panel-deep);
}

.summoner-tab__profile-info {
    flex-grow: 1;
}

.summoner-tab__name {
    color: var(--color-text);
    font-size: var(--font-body);
    -unity-font-style: bold;
}

.summoner-tab__exp {
    margin-top: var(--gap-sm);
}

.summoner-tab__upgrade-button {
    margin-left: var(--gap-md);
}

.summoner-tab__meta-button {
    margin-top: var(--gap-sm);
    margin-bottom: var(--gap-md);
    margin-left: var(--gap-md);
    margin-right: var(--gap-md);
}
