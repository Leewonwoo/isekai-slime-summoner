.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-modal-scrim);
}

.modal-header {
    min-height: var(--touch-min);
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--gap-md);
}

.modal-title {
    color: var(--color-text);
    font-size: var(--font-title);
    -unity-font-style: bold;
}

.modal-close {
    min-width: var(--touch-min);
    min-height: var(--touch-min);
}

.merchant-panel {
    width: 92%;
    max-width: var(--modal-panel-width);
    height: 90%;
    max-height: var(--modal-panel-height);
    min-height: 0;
    background-color: var(--color-transparent);
    background-image: url("project://database/Assets/Art/UIFrames/merchant_popup_frame.png?fileID=21300000&guid=52a18afe3c6382d4e9166e2cf864e829&type=3");
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    -unity-slice-left: 190px;
    -unity-slice-top: 190px;
    -unity-slice-right: 190px;
    -unity-slice-bottom: 190px;
    -unity-slice-scale: 0.38;
    border-width: 0;
    border-radius: 0;
    padding-left: 72px;
    padding-right: 72px;
    padding-top: 72px;
    padding-bottom: 64px;
}

.merchant-intro {
    height: 250px;
    min-height: 250px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: -8px;
    margin-bottom: var(--gap-md);
    padding-left: var(--gap-md);
    padding-right: var(--gap-lg);
}

.merchant-character {
    width: 210px;
    height: 250px;
    flex-shrink: 0;
    margin-right: var(--gap-lg);
    background-image: url("project://database/Assets/Art/UICharacters/merchant_wandering_pixel.png");
    background-size: cover;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: top;
}

.merchant-speech {
    position: relative;
    min-width: 0;
    min-height: 132px;
    flex-grow: 1;
    justify-content: center;
    background-color: rgb(224, 207, 165);
    border-left-width: 4px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: rgb(93, 61, 36);
    border-radius: var(--radius-md);
    padding-left: var(--gap-xl);
    padding-right: var(--gap-lg);
    padding-top: var(--gap-md);
    padding-bottom: var(--gap-md);
}

.merchant-speech__tail {
    position: absolute;
    left: -16px;
    top: 48px;
    width: 28px;
    height: 28px;
    rotate: 45deg;
    background-color: rgb(224, 207, 165);
    border-left-width: 4px;
    border-bottom-width: 4px;
    border-color: rgb(93, 61, 36);
}

.merchant-speech__text {
    color: var(--color-ink);
    font-size: var(--font-caption);
    -unity-font-style: bold;
    white-space: normal;
}

.merchant-cards {
    flex-grow: 1;
    min-height: 0;
}

.merchant-cards .unity-scroll-view__content-container {
    padding-right: var(--gap-sm);
}

.merchant-cards .unity-scroll-view__horizontal-scroller {
    display: none;
}

.merchant-cards .unity-scroll-view__vertical-scroller {
    width: var(--panel-scrollbar-width);
    margin-left: var(--gap-sm);
    background-color: var(--color-transparent);
}

.merchant-cards .unity-scroller__low-button,
.merchant-cards .unity-scroller__high-button {
    display: none;
}

.merchant-cards .unity-base-slider__tracker {
    background-color: var(--color-panel-deep);
    border-width: 0;
    border-radius: var(--radius-sm);
}

.merchant-cards .unity-base-slider__dragger-border {
    background-color: var(--color-transparent);
    border-width: 0;
}

.merchant-cards .unity-base-slider__dragger {
    background-color: var(--color-surface-deep);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: var(--radius-sm);
}

.merchant-card {
    min-height: 310px;
    flex-shrink: 0;
    margin-bottom: var(--gap-md);
    background-color: var(--color-transparent);
    background-image: url("project://database/Assets/Art/UIFrames/merchant_offer_card_frame.png?fileID=21300000&guid=b452dff726cbb2d4981f9052fc632062&type=3");
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    -unity-slice-left: 220px;
    -unity-slice-top: 135px;
    -unity-slice-right: 220px;
    -unity-slice-bottom: 135px;
    -unity-slice-scale: 0.2;
    border-width: 0;
    border-radius: 0;
    padding-left: var(--gap-xl);
    padding-right: var(--gap-xl);
    padding-top: var(--gap-lg);
    padding-bottom: var(--gap-lg);
}

.merchant-card__content {
    min-height: 150px;
    flex-direction: row;
    align-items: flex-start;
}

.merchant-card__info {
    flex-grow: 1;
    min-width: 0;
}

.merchant-card__category {
    color: var(--color-ink-dim);
    font-size: var(--font-small);
}

.merchant-card__icon {
    width: 104px;
    height: 104px;
    flex-shrink: 0;
    margin-right: var(--gap-lg);
    -unity-background-scale-mode: scale-to-fit;
}

.merchant-card__name {
    color: var(--color-ink);
    font-size: var(--font-body);
    -unity-font-style: bold;
    white-space: normal;
}

.merchant-card__description,
.merchant-card__state {
    color: var(--color-ink-dim);
    font-size: var(--font-caption);
    white-space: normal;
}

.merchant-card__state {
    color: var(--color-danger);
    font-size: var(--font-small);
}

.merchant-card__buy {
    min-height: var(--touch-min);
    flex-shrink: 0;
    margin-top: var(--gap-sm);
}
